import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import test from "node:test";

const root = new URL("../", import.meta.url);

test("wallet sync schema is owner-scoped and duplicate-safe", async () => {
  const migration = await readFile(new URL("supabase/migrations/20261117203920_wallet_sync_system.sql", root), "utf8");
  assert.match(migration, /create table public\.wallet_links/);
  assert.match(migration, /create table public\.wallet_events/);
  assert.match(migration, /unique \(user_id, address\)/);
  assert.match(migration, /unique \(wallet_link_id, signature, event_index\)/);
  assert.match(migration, /alter table public\.wallet_links enable row level security/);
  assert.match(migration, /alter table public\.wallet_events enable row level security/);
  assert.match(migration, /Only memecoin-journal Firebase tokens use wallet events/);
});

test("wallet sync uses a saved cursor and requires context before journal import", async () => {
  const server = await readFile(new URL("src/lib/walletSyncServer.ts", root), "utf8");
  const panel = await readFile(new URL("src/components/WalletSyncPanel.tsx", root), "utf8");
  assert.match(server, /options\.until = cursor/);
  const syncBody = server.slice(server.indexOf("export async function syncWalletLink"), server.indexOf("export async function createVerificationChallenge"));
  assert.doesNotMatch(syncBody, /ignoreDuplicates/);
  assert.match(server, /omits `status` on purpose/);
  assert.match(server, /defaultToNull: false/);
  assert.match(server, /importedSignatures\.has\(event\.signature\)/);
  assert.match(server, /TRANSACTION_BATCH_SIZE = 5/);
  assert.match(server, /TRANSACTION_BATCH_DELAY_MS = 650/);
  assert.match(server, /TRANSACTION_FETCH_DEADLINE_MS = 22_000/);
  assert.match(server, /retried individually/);
  assert.match(server, /maxSupportedTransactionVersion: 1/);
  assert.match(server, /assertLikelyWalletAddress/);
  assert.match(server, /not a personal Solana wallet/);
  assert.match(server, /successfulSignatures/);
  assert.match(server, /failedTransactions/);
  assert.match(server, /SIGNATURE_PAGE_LIMIT = 30/);
  assert.match(server, /sync stopped without advancing its cursor so older activity is not skipped/);
  assert.match(panel, /Waiting for exit/);
  assert.match(panel, /A buy without a detected sell is not a realized loss/);
  assert.match(panel, /failed on-chain attempt/i);
  assert.match(server, /isUsable/);
  assert.match(server, /mode === "rescan"/);
  assert.match(server, /sync cursor was not advanced/);
  assert.match(server, /firstMissing === 0/);
  assert.match(server, /HELIUS_API_KEY/);
  assert.match(server, /getTransactionsForAddress/);
  assert.match(server, /sortOrder: "asc"/);
  assert.match(server, /signature: \{ gt: cursor \}/);
  assert.match(server, /limit: SYNC_BATCH_LIMIT \+ 1/);
  assert.match(server, /tokenSnapshots/);
  assert.match(server, /marketCapSnapshotAt/);
  assert.match(panel, /Reason and setup are required/);
  assert.match(panel, /walletEventIds: reviewing\.eventIds/);
  assert.match(panel, /Verify ownership/);
  assert.match(panel, /Sync wallet/);
  assert.match(panel, /Repair history/);
  assert.match(panel, /buildWalletPositions\(events, existingSignatureSet\)/);
  assert.match(panel, /Dismiss for now/);
  assert.match(panel, /Waiting for full exit/);
  assert.match(panel, /prevents incorrect realized P&L/);
  assert.match(panel, /setLinks\(\(current\) => current\.filter/);
  assert.doesNotMatch(panel, /border border-blue-200/);
  assert.doesNotMatch(panel, /border border-emerald-200/);
  assert.match(panel, /data-tour="wallet-sync"/);
  assert.doesNotMatch(panel, />Beta</);
  assert.match(panel, /Positions with missing entry history cannot be saved/);
  assert.match(panel, /unsupported/);
});

test("the welcome tour measures each new target once after layout settles", async () => {
  const tour = await readFile(new URL("src/components/WelcomeTourModal.tsx", root), "utf8");
  const dailyJournal = await readFile(new URL("src/components/DailyJournalView.tsx", root), "utf8");
  assert.doesNotMatch(tour, /setTargetRect\(null\);\s*setStepIndex/);
  assert.match(tour, /new ResizeObserver\(scheduleSettledMeasure\)/);
  assert.match(tour, /duration-400 ease-out/);
  assert.doesNotMatch(tour, /setTimeout\(locateTarget, 90\)/);
  assert.doesNotMatch(tour, /setTimeout\(locateTarget, 220\)/);
  assert.match(tour, /daily-journal-writing-workbench/);
  assert.match(tour, /daily-journal-review-workbench/);
  assert.match(tour, /daily-journal-recovery-workbench/);
  assert.match(tour, /announceStep\(\);\s*if \(attempt < 30\)/);
  assert.match(tour, /previousViewRef\.current !== step\.viewTab/);
  assert.doesNotMatch(dailyJournal, /if \(!tutorialMode\) return;\s*const syncTourPanels/);
  assert.doesNotMatch(tour, /selector: '\[data-tour="wallet-scan"\]'/);
});

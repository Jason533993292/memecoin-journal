# Copy these names into Railway → your staging service → Variables.
# Replace every <...> placeholder in Railway only. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://tndqtaouizztihzggwnh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
# Use Firebase's registered OAuth handler by default. Replace this with the
# deployment/custom domain only after adding that bare hostname to Firebase
# Authorized Domains and its /__/auth/handler URL to Google OAuth.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=memecoin-journal.firebaseapp.com

# Feedback notifications (server-only)
RESEND_API_KEY=re_replace_with_your_resend_api_key
FEEDBACK_EMAIL_TO=journal.memecoin@gmail.com
FEEDBACK_EMAIL_FROM="Memecoin Journal <onboarding@resend.dev>"
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-secret-key>
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=<entire-firebase-service-account-json-on-one-line>
NEXT_PUBLIC_DATA_BACKEND=supabase

# Needed only if Firebase App Check is enabled for this deployment.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=<your-fraud-defense-site-key>

{
  "name": "memecoin-journal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/*.test.mts",
    "test:e2e": "playwright test",
    "smoke:release": "node scripts/verify-public-release.mjs",
    "monitor:services": "node scripts/verify-service-readiness.mjs",
    "test:staging:isolation": "node scripts/verify-staging-isolation.mjs",
    "backup:verify": "node scripts/verify-supabase-backups.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore \"node --test tests/firestoreRules.test.mjs\"",
    "migration:export": "node scripts/export-firestore-migration.mjs",
    "migration:import:staging": "node scripts/import-supabase-migration.mjs",
    "migration:verify": "node scripts/verify-migration-counts.mjs",
    "deployment:verify": "node scripts/verify-deployment-config.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "railway": "^3.12.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "sharp": "0.35.5",
    "uuid": "11.1.1"
  }
}
